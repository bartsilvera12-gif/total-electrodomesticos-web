# Total Electrodomésticos — Apache (Hostinger)
#
# Hostinger sirve la raíz del repo y el sitio compilado vive en /out.
# Esto lo mapea sin duplicar archivos: lo que el visitante pide como /productos
# se busca en /out/productos.
#
# Después de tocar el código hay que correr `npm run build` y commitear /out,
# que es lo que se publica.
#
# Publicar un producto desde el ERP NO necesita build: los listados consultan
# Supabase en el navegador, y la ficha de un producto sin HTML propio la
# atiende /producto/ver/ (ver la regla más abajo). El build sirve para que esos
# productos tengan además su HTML indexable.

Options -Indexes
DirectoryIndex index.html

# Caché
#
# Sin esto el HTML quedaba guardado (navegador, LiteSpeed de Hostinger y
# Cloudflare) y el cliente seguía viendo la versión vieja después de publicar:
# desactivó la categoría PRUEBA y le seguía saliendo. El HTML viejo además trae
# el JS viejo, así que ni siquiera llegaba a consultar las categorías al día.
#
# - HTML y los .txt de Next (lo que pide al navegar entre páginas): se
#   revalidan siempre. Si no cambiaron, Apache contesta 304 y no se descarga
#   nada; si cambiaron, se ve lo nuevo en la siguiente carga.
# - El JS y el CSS de /_next/static/ no se tocan: su nombre cambia con el
#   contenido, así que un archivo guardado nunca queda viejo.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set X-LiteSpeed-Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

# La caché de páginas de LiteSpeed (Hostinger) no debe guardar el sitio: el
# HTML cambia con cada publicación y los datos se piden en vivo a Supabase.
<IfModule LiteSpeed>
  CacheLookup public off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS (Cloudflare termina el TLS y avisa por esta cabecera)
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

  # Sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # Nada de código fuente ni de configuración
  RewriteRule ^(src|scripts|supabase|node_modules|\.git|\.next)/ - [F,L]
  RewriteRule ^(package.*\.json|.*\.ts|.*\.tsx|.*\.mjs|.*\.md|.*\.sql|.*\.lock)$ - [F,L]

  # Producto o categoría publicados en el ERP DESPUÉS del último build: su HTML
  # todavía no existe y sin esto darían 404. Se mandan a una página de respaldo
  # que resuelve el slug en el navegador, como hace el sitio de Marilia con
  # Producto.dc.html?id=. Las páginas ya generadas siguen teniendo prioridad:
  # son las que traen el HTML completo para los buscadores.
  RewriteCond %{DOCUMENT_ROOT}/out/producto/$1/index.html !-f
  RewriteRule ^producto/([^/]+)/?$ /out/producto/ver/index.html?slug=$1 [L,QSA]

  RewriteCond %{DOCUMENT_ROOT}/out/categoria/$1/index.html !-f
  RewriteRule ^categoria/([^/]+)/?$ /out/categoria/ver/index.html?slug=$1 [L,QSA]

  # Todo lo demás sale de /out
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteRule ^(.*)$ /out/$1 [L]
</IfModule>
